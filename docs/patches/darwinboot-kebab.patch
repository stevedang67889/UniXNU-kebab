+  //
+  // Prefer the base of DRAM: the kernel runs at this physical address with the
+  // MMU off, and XNU's early mapping assumes it sits where the bootloader puts
+  // a normal kernel. The generic lowest-fit allocation lands in low SRAM-like
+  // memory (0x7D000 on this board) and the kernel faults during relocation.
+  //
+  {
+    STATIC CONST UINT64  Preferred[] = { 0x80000000ULL, 0x81000000ULL, 0x88000000ULL, 0x90000000ULL, 0xA0000000ULL };
+    UINTN                Index;
+    for (Index = 0; Index < ARRAY_SIZE (Preferred); Index++) {
+      Candidate = Preferred[Index] + (Kernel->Base & (BLOCK_SIZE - 1));
+      if (!EFI_ERROR (gBS->AllocatePages (AllocateAddress, EfiLoaderCode, EFI_SIZE_TO_PAGES (WindowSize), &Candidate))) {
+        *Address = Candidate;
+        FreePool (Map);
+        return EFI_SUCCESS;
+      }
+    }
+  }
   for (Offset = 0; Offset + Stride <= Size; Offset += Stride) {
     Descriptor = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)Map + Offset);
     if ((Descriptor->Type != EfiConventionalMemory) || (Descriptor->NumberOfPages == 0)) { continue; }
+    // XNU must run from DRAM: skip the low controller/ATF memory so the first fit
+    // does not land at 0x7D000, where the early relocation loop faults.
+    if (Descriptor->PhysicalStart < 0x40000000ULL) { continue; }
     End = RunEnd (Map, Size, Stride, Descriptor->PhysicalStart,
                   Descriptor->PhysicalStart + EFI_PAGES_TO_SIZE (Descriptor->NumberOfPages));
     RunBytes = End - Descriptor->PhysicalStart;
