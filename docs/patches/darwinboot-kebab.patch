+    //
+    if ((Video[0] != 0) && (Video[2] != 0)) {
+      UINT32 *Fb = (UINT32 *)(UINTN)Video[0];
+      UINTN   RowPixels = Video[2] / 4;
+      UINTN   Row;
+      UINTN   Col;
+      UINT32  Colour = EFI_ERROR (Status) ? 0x000000FF : 0x00FFFFFF;   // red on error, white on success
+      for (Row = 8; Row < 120; Row++) {
+        for (Col = 400; Col < 600; Col++) {
+          Fb[Row * RowPixels + Col] = Colour;
+        }
+      }
+    }
     if (!EFI_ERROR (Status)) {
       DarwinEnter (ArgsAddress, Address + Kernel.Entry - Kernel.Base, Address, WindowSize, Video[0], Video[2] * Video[4]);
       CpuDeadLoop ();
