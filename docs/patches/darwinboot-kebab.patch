+typedef struct {
+  EFI_DEVICE_PATH_PROTOCOL    Header;
+  EFI_GUID                    NameGuid;
+  CHAR16                      Name[1];
+} FV_FILEPATH_NODE;
+
+STATIC
+VOID
+PrintLoadedImages (
+  VOID
+  )
+{
+  EFI_STATUS                    Status;
+  EFI_HANDLE                    *Handles;
+  UINTN                         Count;
+  UINTN                         Index;
+
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiLoadedImageProtocolGuid, NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  DEBUG ((DEBUG_ERROR, "--- images in the firmware volume ---\n"));
+  for (Index = 0; Index < Count; Index++) {
+    EFI_LOADED_IMAGE_PROTOCOL     *Loaded;
+    EFI_COMPONENT_NAME2_PROTOCOL  *Name2;
+    EFI_COMPONENT_NAME_PROTOCOL   *Name1;
+    CHAR16                        *DriverName;
+    CHAR16                        *DriverName8;
+    EFI_DEVICE_PATH_PROTOCOL      *Node;
+    CONST CHAR16                  *Name = NULL;
+
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiLoadedImageProtocolGuid, (VOID **)&Loaded))) {
+      continue;
+    }
+
+    if ((UINTN)Loaded->ImageBase < 0x0000B0000000ULL) {
+      continue;
+    }
+
+    Node = Loaded->FilePath;
+    while ((Node != NULL) && !IsDevicePathEnd (Node)) {
+      if ((DevicePathType (Node) == MEDIA_DEVICE_PATH) && (DevicePathSubType (Node) == 0x06)) {
+        Name = ((FV_FILEPATH_NODE *)Node)->Name;
+        break;
+      }
+
+      Node = NextDevicePathNode (Node);
+    }
+
+    if ((Name != NULL) && (Name[0] != L'\0')) {
+      DEBUG ((DEBUG_ERROR, "%lx %lx %s\n", (UINT64)(UINTN)Loaded->ImageBase, (UINT64)Loaded->ImageSize, Name));
+      continue;
+    }
+
+    if (!EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiComponentName2ProtocolGuid, (VOID **)&Name2)) &&
+        (Name2->GetDriverName != NULL) &&
+        !EFI_ERROR (Name2->GetDriverName (Name2, "en", &DriverName)) && (DriverName != NULL)) {
+      DEBUG ((DEBUG_ERROR, "%lx %lx %s\n", (UINT64)(UINTN)Loaded->ImageBase, (UINT64)Loaded->ImageSize, DriverName));
+      continue;
+    }
+
+    if (!EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiComponentNameProtocolGuid, (VOID **)&Name1)) &&
+        (Name1->GetDriverName != NULL) &&
+        !EFI_ERROR (Name1->GetDriverName (Name1, "eng", &DriverName8)) && (DriverName8 != NULL)) {
+      DEBUG ((DEBUG_ERROR, "%lx %lx %s\n", (UINT64)(UINTN)Loaded->ImageBase, (UINT64)Loaded->ImageSize, DriverName8));
+      continue;
+    }
+
+    DEBUG ((DEBUG_ERROR, "%lx %lx ?\n", (UINT64)(UINTN)Loaded->ImageBase, (UINT64)Loaded->ImageSize));
+  }
+
+  FreePool (Handles);
+}
