+def _adt_walk(blob, offset):
+    """Parse one ADT node: returns (name, props, children, order, next offset)."""
+    count, children = struct.unpack_from('<II', blob, offset)
+    offset += 8
+    props, order = {}, []
+    for _ in range(count):
+        raw = blob[offset:offset + 32]
+        length, = struct.unpack_from('<I', blob, offset + 32)
+        key = raw.split(b'\0')[0].decode()
+        props[key] = blob[offset + 36:offset + 36 + length]
+        order.append(key)
+        offset += 36 + length + (-length % 4)
+    kids = []
+    for _ in range(children):
+        kid, offset = _adt_walk(blob, offset)
+        kids.append(kid)
+    return (props.get('name', b'\0').split(b'\0')[0].decode(), props, kids, order), offset
+
+
+def _adt_encode(node):
+    _, props, kids, order = node
+    body = struct.pack('<II', len(order), len(kids))
+    for key in order:
+        data = props[key]
+        body += struct.pack('<32sI', key.encode(), len(data))
+        body += data + bytes(-len(data) % 4)
+    return body + b''.join(_adt_encode(kid) for kid in kids)
+
+
+def _inject_xnu_nodes(blob, pram_base, pram_size):
+    """Add the nodes XNU looks up but the tagged-node path does not produce.
+
+    XNU finds the interrupt controller with SecureDTFindEntry(
+    "interrupt-controller", "master") and pe_arm_map_interrupt_controller()
+    also wants a timer node, otherwise ml_init_timebase never runs. The panic
+    log region needs /pram and /chosen/embedded-panic-log-size.
+    """
+    root, _ = _adt_walk(blob, 0)
+    _, props, kids, order = root
+    by_name = {kid[0]: kid for kid in kids}
+    chosen = by_name.get('chosen')
+    if chosen is None:
+        return blob
+    chosen[1]['embedded-panic-log-size'] = struct.pack('<I', pram_size)
+    if 'embedded-panic-log-size' not in chosen[3]:
+        chosen[3].append('embedded-panic-log-size')
+    if 'pram' not in by_name:
+        kids.append({'pram': 0} and ('pram', {'name': b'pram\0', 'reg': struct.pack('<QQ', pram_base, pram_size)},
+                                     [], ['name', 'reg']))
+    arm_io = by_name.get('arm-io')
+    if arm_io is not None:
+        ranges = arm_io[1].get('ranges')
+        window_base = struct.unpack_from('<Q', ranges, 8)[0] if ranges else 0x17000000
+        controller = next((kid for kid in arm_io[2] if kid[0] in ('intc', 'gic')), None)
+        if controller is not None:
+            controller[1]['name'] = b'gic\0'
+            controller[1]['interrupt-controller'] = b'master\0'
+            controller[1]['virtual-timer-intid'] = struct.pack('<I', 27)
+            for key in ('name', 'interrupt-controller', 'virtual-timer-intid'):
+                if key not in controller[3]:
+                    controller[3].append(key)
+        # XNU reads redistributor-stride as one 32-bit cell; the device tree
+        # writes it as two cells and the encoder then produces eight bytes.
+        controller = next((kid for kid in arm_io[2] if kid[0] in ('intc', 'gic')), None)
+        if controller is not None and 'reg' in controller[1] and len(controller[1]['reg']) == 32:
+            # XNU maps the controller from these addresses without adding the
+            # window base back, so hand it absolute addresses. absolute GIC
+            # addresses: the encoder produced window offsets.
+            values = list(struct.unpack('<4Q', controller[1]['reg']))
+            values[0] += window_base
+            values[2] += window_base
+            controller[1]['reg'] = struct.pack('<4Q', *values)
