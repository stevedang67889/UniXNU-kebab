diff --git a/Platforms/OnePlus/kebabPkg/Driver/KebabBootLog/KebabBootLog.c b/Platforms/OnePlus/kebabPkg/Driver/KebabBootLog/KebabBootLog.c
new file mode 100644
index 00000000..afc12bf7
--- /dev/null
+++ b/Platforms/OnePlus/kebabPkg/Driver/KebabBootLog/KebabBootLog.c
@@ -0,0 +1,82 @@
+/** @file
+  Reads the checkpoint ring that the kernel probe stubs leave in RAM.
+
+  The ring lives at a fixed physical address outside the kernel window, so a
+  warm reset keeps it. A stub writes one record per checkpoint; this driver runs
+  before the payload is loaded, prints what it finds, and clears the magic so a
+  later boot without a kernel run reports nothing instead of stale records.
+**/
+
+#include <Uefi.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+#define KEBAB_BOOTLOG_BASE      0xB9000000ULL
+#define KEBAB_BOOTLOG_SIZE      0x00800000ULL
+#define KEBAB_BOOTLOG_MAGIC     0x474C424B
+#define KEBAB_BOOTLOG_VERSION   1
+
+typedef struct {
+  UINT32  Magic;
+  UINT32  Version;
+  UINT32  Count;
+  UINT32  Dropped;
+} KEBAB_BOOTLOG_HEADER;
+
+typedef struct {
+  UINT64  Sequence;
+  UINT64  Checkpoint;
+  UINT64  Value;
+  UINT64  Counter;
+} KEBAB_BOOTLOG_RECORD;
+
+#define KEBAB_BOOTLOG_CAPACITY \
+  ((KEBAB_BOOTLOG_SIZE - sizeof (KEBAB_BOOTLOG_HEADER)) / sizeof (KEBAB_BOOTLOG_RECORD))
+
+EFI_STATUS
+EFIAPI
+KebabBootLogEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  volatile KEBAB_BOOTLOG_HEADER  *Header;
+  volatile KEBAB_BOOTLOG_RECORD  *Records;
+  UINT32                         Count;
+  UINT32                         Index;
+
+  Header  = (volatile KEBAB_BOOTLOG_HEADER *)(UINTN)KEBAB_BOOTLOG_BASE;
+  Records = (volatile KEBAB_BOOTLOG_RECORD *)(UINTN)(KEBAB_BOOTLOG_BASE + sizeof (KEBAB_BOOTLOG_HEADER));
+
+  DEBUG ((DEBUG_ERROR, "\n================ KEBAB BOOTLOG ================\n"));
+  DEBUG ((DEBUG_ERROR, "BOOTLOG base=%lx magic=%08x version=%u count=%u dropped=%u\n",
+          (UINT64)KEBAB_BOOTLOG_BASE, Header->Magic, Header->Version,
+          Header->Count, Header->Dropped));
+  DEBUG ((DEBUG_ERROR, "===============================================\n"));
+
+  if (Header->Magic != KEBAB_BOOTLOG_MAGIC) {
+    DEBUG ((DEBUG_ERROR, "BOOTLOG no records; holding the panel for five seconds\n"));
+    gBS->Stall (5000000);
+    return EFI_SUCCESS;
+  }
+
+  Count = Header->Count;
+  if (Count > KEBAB_BOOTLOG_CAPACITY) {
+    Count = KEBAB_BOOTLOG_CAPACITY;
+  }
+
+  DEBUG ((DEBUG_ERROR, "BOOTLOG records=%u of %u capacity\n", Count, (UINT32)KEBAB_BOOTLOG_CAPACITY));
+  for (Index = 0; Index < Count; Index++) {
+    DEBUG ((DEBUG_ERROR, "BOOTLOG %u cp=%lx value=%lx t=%lu\n",
+            Index,
+            Records[Index].Checkpoint,
+            Records[Index].Value,
+            Records[Index].Counter));
+  }
+
+  Header->Magic = 0;
+  gBS->Stall (5000000);
+  return EFI_SUCCESS;
+}
