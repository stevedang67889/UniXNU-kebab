   // Get Frame Buffer Memory
   Status = GetFrameBufferMemory (&FbBase, &FbLength);
+
+  // One-shot calibration grid: a marker every 100 pixels along the top row and
+  // the left column, so a photo reveals the real stride and visible area.
+  {
+    STATIC BOOLEAN  Probed = FALSE;
+    if (!Probed && !EFI_ERROR (Status)) {
+      UINT32 *Fb = (UINT32 *)(UINTN)FbBase;
+      UINTN   X, Y, I;
+      Probed = TRUE;
+      for (I = 0; I < 40; I++) {
+        X = I * 100;
+        if (X >= FB_WIDTH) break;
+        for (Y = 0; Y < 80; Y++) {
+          Fb[Y * FB_WIDTH + X] = 0x00FFFFFF;                       // top ruler
+          Fb[(FB_HEIGHT - 1 - Y) * FB_WIDTH + X] = 0x00FFFFFF;     // bottom ruler
+        }
+      }
+      for (I = 0; I < 40; I++) {
+        Y = I * 100;
+        if (Y >= FB_HEIGHT) break;
+        for (X = 0; X < 80; X++) {
+          Fb[Y * FB_WIDTH + X] = 0x00FF00FF;                       // left ruler
+          Fb[Y * FB_WIDTH + (FB_WIDTH - 1 - X)] = 0x00FF00FF;      // right ruler
+        }
+      }
+    }
+  }
   if (EFI_ERROR (Status)) {
     return 0;
   }
