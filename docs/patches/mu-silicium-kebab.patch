+++ b/Silicon/Silicium/SiliciumPkg/Library/FrameBufferSerialPortLib/FrameBufferSerialPortLib.c
@@ -183,6 +183,12 @@ WriteFrameBuffer (
       AdvanceNewLine (FbBase, FbLength, CurrentPosition, MaxPosition);
     } else if (Character == '\r') {
       CurrentPosition->XPos = 0;
+    } else if (Character == '\f') {
+      // Form feed clears the screen and homes the cursor. DarwinBoot uses it to
+      // put its hand-off log at the top of the panel.
+      ZeroMem ((VOID *)FbBase, FB_WIDTH * FB_HEIGHT * FB_BPP);
+      CurrentPosition->XPos = 0;
+      CurrentPosition->YPos = 0;
     }
 
     return;
@@ -250,6 +256,33 @@ SerialPortWrite (
 
   // Get Frame Buffer Memory
   Status = GetFrameBufferMemory (&FbBase, &FbLength);
+
+  // One-shot calibration grid: a marker every 100 pixels along the top row and
+  // the left column, so a photo reveals the real stride and visible area.
+  {
+    STATIC BOOLEAN  Probed = FALSE;
+    if (!Probed && !EFI_ERROR (Status)) {
+      UINT32 *Fb = (UINT32 *)(UINTN)FbBase;
+      UINTN   X, Y, I;
+      Probed = TRUE;
+      for (I = 0; I < 40; I++) {
+        X = I * 100;
+        if (X >= FB_WIDTH) break;
+        for (Y = 0; Y < 80; Y++) {
+          Fb[Y * FB_WIDTH + X] = 0x00FFFFFF;                       // top ruler
+          Fb[(FB_HEIGHT - 1 - Y) * FB_WIDTH + X] = 0x00FFFFFF;     // bottom ruler
+        }
+      }
+      for (I = 0; I < 40; I++) {
+        Y = I * 100;
+        if (Y >= FB_HEIGHT) break;
+        for (X = 0; X < 80; X++) {
+          Fb[Y * FB_WIDTH + X] = 0x00FF00FF;                       // left ruler
+          Fb[Y * FB_WIDTH + (FB_WIDTH - 1 - X)] = 0x00FF00FF;      // right ruler
+        }
+      }
+    }
+  }
   if (EFI_ERROR (Status)) {
     return 0;
   }
