diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index ff5296d..c2ce267 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -31,6 +31,7 @@
 #include <arm/cpu_data_internal.h>
 #include <arm/misc_protos.h>
 #include <arm/thread.h>
+#include <arm/machine_cpu.h>
 #include <arm/rtclock.h>
 #include <arm/trap_internal.h> /* for IS_ARM_GDB_TRAP() et al */
 #include <arm64/proc_reg.h>
@@ -2109,7 +2110,42 @@ sleh_irq(arm_saved_state_t *state)
 	int preemption_level = sleh_get_preemption_level();
 #endif
 
+#if defined(KEBAB)
+	/*
+	 * kebab: TrustZone owns GIC Group 0, so the timer and IPIs that other
+	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs.  This bypasses
+	 * the AppleARMCPU interrupt_handler, which is not present in this
+	 * bring-up kernel.
+	 */
+	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
+	uint32_t intid = (uint32_t)(iar & 0xFFFFFFULL);
 
+	if (intid >= 1020 && intid <= 1023) {
+		return; /* spurious */
+	}
+	if (intid == kebab_vtimer_intid) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
+		cdp->cpu_decrementer = -1; /* Large */
+		rtclock_intr(TRUE);
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	} else if (intid < 16) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
+		/* Ack before handling so an IPI raised meanwhile is not lost. */
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		__builtin_arm_isb(ISB_SY);
+		cpu_signal_handler();
+	} else {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
+		if (cdp->interrupt_handler) {
+			cdp->interrupt_handler(cdp->interrupt_target,
+			    cdp->interrupt_refCon,
+			    cdp->interrupt_nub,
+			    intid);
+		}
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	}
+	__builtin_arm_isb(ISB_SY);
+#else
 	sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
 
 #if USE_APPLEARMSMP
@@ -2122,8 +2158,9 @@ sleh_irq(arm_saved_state_t *state)
 	    cdp->interrupt_source);
 #endif
 
-	entropy_collect();
+#endif
 
+	entropy_collect();
 
 	sleh_interrupt_handler_epilogue();
 #if MACH_ASSERT
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 3ad743f..f30ce8a 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -3,6 +3,7 @@
  */
 
 #include <stdint.h>
+#include <libkern/section_keywords.h>
 #include <arm64/proc_reg.h>
 #include <kern/clock.h>
 #include <mach/mach_time.h>
@@ -16,6 +17,12 @@
 #define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
 MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS, MACHINE_TIMEOUT_UNIT_NSEC, NULL);
 
+#if defined(KEBAB)
+/* Read from the GIC node on the boot CPU before the GIC and RO-late lockdown. */
+SECURITY_READ_ONLY_LATE(uint32_t) kebab_vtimer_intid = KEBAB_VTIMER_INTID;
+SECURITY_READ_ONLY_LATE(uint32_t) kebab_gicr_stride = GICR_PE_SIZE;
+#endif
+
 static vm_offset_t gicd_base;
 static vm_offset_t gicr_base;
 static vm_offset_t gicr_size;
@@ -50,7 +57,7 @@ find_gicr_pe_base()
 	// We only care about aff1 and aff0
 	uint32_t phys_id = __builtin_arm_rsr64("MPIDR_EL1") & (MPIDR_AFF1_MASK | MPIDR_AFF0_MASK);
 
-	for (vm_offset_t offset = 0; offset < gicr_size; offset += GICR_PE_SIZE) {
+	for (vm_offset_t offset = 0; offset < gicr_size; offset += kebab_gicr_stride) {
 		vm_offset_t gicr_pe_base = gicr_base + offset;
 		uint64_t gicr_typer = gicr_read64(GICR_TYPER);
 		uint32_t aff_value = (uint32_t) (gicr_typer >> GICR_TYPER_AFFINITY_VALUE_SHIFT) & (MPIDR_AFF1_MASK | MPIDR_AFF0_MASK);
@@ -96,6 +103,37 @@ pe_init_fiq()
 			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
 		}
 
+#if defined(KEBAB)
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			kebab_vtimer_intid = intid;
+		}
+		kprintf("KEBAB GIC: virtual timer INTID %u\n", kebab_vtimer_intid);
+
+		void const *stride_prop;
+		unsigned int stride_size;
+		if (SecureDTGetProperty(entry, "redistributor-stride", &stride_prop, &stride_size) == kSuccess) {
+			if (stride_size != sizeof(uint32_t) && stride_size != sizeof(uint64_t)) {
+				panic("%s: invalid redistributor-stride size %u", __func__, stride_size);
+			}
+			uint32_t stride = (stride_size == sizeof(uint32_t)) ?
+			    *(const uint32_t *)stride_prop : (uint32_t)*(const uint64_t *)stride_prop;
+			if (stride != 0x20000 && stride != 0x40000) {
+				panic("%s: unsupported redistributor stride 0x%x", __func__, stride);
+			}
+			kebab_gicr_stride = stride;
+		}
+		kprintf("KEBAB GIC: redistributor stride 0x%x\n", kebab_gicr_stride);
+#endif
+
 		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
 
 		uint64_t const gicd_base_prop = ((uint64_t const *) prop)[0];
@@ -141,11 +179,22 @@ pe_init_fiq()
 		}
 	}
 
+#if defined(KEBAB)
+	/* TrustZone owns Group 0; all interrupts we own are Group 1 NS and
+	 * arrive as IRQs in sleh_irq().  The non-secure IGROUPR0 read-back may
+	 * still look zero on real hardware; delivery is what matters. */
+	gicr_write32(GICR_IGROUPR0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicr_write32(GICR_ISENABLER0, (1U << kebab_vtimer_intid) | (1U << KEBAB_IPI_SGI));
+#else
 	// Configure timers and legacy FIQ to be group 0
 	gicr_write32(GICR_IGROUPR0, 0x81FFFFFF);
 
 	// Enable PPI 27
 	gicr_write32(GICR_ISENABLER0, (1 << 27));
+#endif
 
 	// Enable system register access
 	uint64_t icc_sre = __builtin_arm_rsr64("ICC_SRE_EL1");
@@ -153,8 +202,12 @@ pe_init_fiq()
 	__builtin_arm_wsr64("ICC_SRE_EL1", icc_sre);
 	__builtin_arm_isb(ISB_SY);
 
+#if defined(KEBAB)
+	__builtin_arm_wsr64("ICC_BPR1_EL1", 0);
+#else
 	// Set priority masks and binary point for group 0
 	__builtin_arm_wsr64("ICC_BPR0_EL1", 0);
+#endif
 	__builtin_arm_wsr64("ICC_PMR_EL1", 0xFF);
 
 	// Set EOI mode of this processor
@@ -162,12 +215,24 @@ pe_init_fiq()
 	icc_ctlr &= ~ICC_CTLR_EOIMODE;
 	__builtin_arm_wsr64("ICC_CTLR_EL1", icc_ctlr);
 
+#if defined(KEBAB)
+	/* ABL leaves only ARE_NS; enable Group 1 and Group 1A. */
+	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
+	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
+	gicd_write32(GICD_CTLR, gicd_ctlr);
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
+	__builtin_arm_isb(ISB_SY);
+#else
 	// Enable the forwarding of the vtimer interrupt
 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
 	gicd_ctlr |= GICD_CTLR_ENABLEGRP0;
 	gicd_write32(GICD_CTLR, gicd_ctlr);
 	__builtin_arm_wsr64("ICC_IGRPEN0_EL1", 1);
 	__builtin_arm_isb(ISB_SY);
+#endif
 }
 #else
 void
