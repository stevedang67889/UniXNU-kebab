diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 8fe43b6..2c7dbfa 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -611,6 +611,12 @@ arm_init(
 #endif /* KPERF */
 
 	PE_init_cpu();
+	/* KEBAB: signal that PE_init_cpu returned inside arm_init. */
+	{
+		register unsigned long x0 __asm__("x0") = 0x84000009UL;
+		register unsigned long x1 __asm__("x1") = 0;
+		__asm__ volatile ("smc #0" : "+r"(x0) : "r"(x1) : "memory");
+	}
 	fiq_context_init(TRUE);
 
 
diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index 433b6cd..5eac752 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -512,6 +512,12 @@ PE_init_platform(boolean_t vm_initialized, void *args)
 				bcopy(prop, &gPlatformMemoryID, size);
 			}
 		}
+		/* KEBAB: signal that the DT block finished and pe_init_debug is next. */
+		{
+			register unsigned long x0 __asm__("x0") = 0x84000009UL;
+			register unsigned long x1 __asm__("x1") = 0;
+			__asm__ volatile ("smc #0" : "+r"(x0) : "r"(x1) : "memory");
+		}
 		pe_init_debug();
 	}
