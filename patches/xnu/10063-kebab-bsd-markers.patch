diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index bb558ee..15cd001 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -203,6 +203,31 @@
 #include <tests/xnupost.h>
 #endif
 
+/* Filled by the GIC stub once it maps the GOP framebuffer; the BSD markers
+ * paint directly through these values, so they never call ml_io_map. */
+uint64_t kebab_fb_va = 0;
+uint64_t kebab_fb_band = 0;
+
+static void
+kebab_bsd_mark(int band)
+{
+	uint64_t bytes;
+	static const uint32_t colors[4] = {
+		0xFFFFFFFFu, 0xFFFFFF00u, 0xFF00FF00u, 0xFF0000FFu
+	};
+	volatile uint32_t *p;
+
+	if (band < 10 || band >= 14 || kebab_fb_va == 0 || kebab_fb_band == 0) {
+		return;
+	}
+	bytes = kebab_fb_band;
+	p = (volatile uint32_t *)(kebab_fb_va + bytes * (uint64_t)(band - 10));
+	for (uint64_t i = 0; i < bytes / 4; i++) {
+		p[i] = colors[band - 10];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
 void * get_user_regs(thread_t);         /* XXX kludge for <machine/thread.h> */
 void IOKitInitializeTime(void);         /* XXX */
 void IOSleep(unsigned int);             /* XXX */
@@ -487,6 +512,8 @@ bsd_init(void)
 		.p_csflags = CS_VALID,
 	};
 	struct task_ro_data kerntask_ro_data = { };
+
+	kebab_bsd_mark(10);
 #if CONFIG_NETBOOT || CONFIG_IMAGEBOOT
 	boolean_t       netboot = FALSE;
 #endif
@@ -515,6 +542,7 @@ bsd_init(void)
 	/* Initialize kauth subsystem before instancing the first credential */
 	bsd_init_kprintf("calling kauth_init\n");
 	kauth_init();
+	kebab_bsd_mark(11);
 
 	/* kernel_task->proc = kernproc; */
 	set_bsdtask_info(kernel_task, (void *)kernproc);
@@ -539,6 +567,7 @@ bsd_init(void)
 	kauth_cred_set(&kernproc_ro_data.p_ucred.__smr_ptr, vfs_context0.vc_ucred);
 	kernproc->p_proc_ro = proc_ro_alloc(kernproc, &kernproc_ro_data,
 	    kernel_task, &kerntask_ro_data);
+	kebab_bsd_mark(12);
 
 	/* give kernproc a name */
 	bsd_init_kprintf("calling process_name\n");
@@ -883,6 +912,7 @@ bsd_init(void)
 
 		bsd_init_kprintf("calling setconf\n");
 		setconf();
+		kebab_bsd_mark(13);
 #if CONFIG_NETBOOT
 		netboot = (mountroot == netboot_mountroot);
 #endif
