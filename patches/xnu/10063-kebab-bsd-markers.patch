--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -203,6 +203,39 @@
 #include <tests/xnupost.h>
 #endif
 
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* Bring-up: paint a band on the GOP framebuffer from BSD context.  The
+ * physical base is the board splash constant; geometry falls back to the
+ * known 1080x2400 panel when PE_state.video is not filled in yet. */
+static void
+kebab_bsd_mark(int band)
+{
+	unsigned long rb = PE_state.video.v_rowBytes;
+	unsigned long h = PE_state.video.v_height;
+
+	if (rb == 0) {
+		rb = 0x1000;
+	}
+	if (h == 0) {
+		h = 2400;
+	}
+	uint64_t len = (uint64_t)rb * h;
+	uint64_t fb = ml_io_map(0x9C000000, (vm_size_t)len);
+	uint64_t bytes = len >> 4;
+	uint32_t colors[4] = { 0xFFFFFFFFu, 0xFFFFFF00u, 0xFF00FF00u, 0xFF0000FFu };
+	volatile uint32_t *p;
+
+	if (fb == 0 || bytes < 4 || band < 10 || band >= 14) {
+		return;
+	}
+	p = (volatile uint32_t *)(fb + bytes * (uint64_t)(band - 10));
+	for (uint64_t i = 0; i < bytes / 4; i++) {
+		p[i] = colors[band - 10];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
 void * get_user_regs(thread_t);         /* XXX kludge for <machine/thread.h> */
 void IOKitInitializeTime(void);         /* XXX */
 void IOSleep(unsigned int);             /* XXX */
