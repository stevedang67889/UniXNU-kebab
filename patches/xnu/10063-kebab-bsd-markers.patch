diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index bb558ee..4139519 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -203,6 +203,35 @@
 #include <tests/xnupost.h>
 #endif
 
+extern boolean_t ml_set_interrupts_enabled(boolean_t enable);
+
+/* Filled by the GIC stub once it maps the GOP framebuffer; the BSD markers
+ * paint directly through these values, so they never call ml_io_map. */
+uint64_t kebab_fb_va = 0;
+uint64_t kebab_fb_band = 0;
+
+static void
+kebab_bsd_mark(int band)
+{
+	uint64_t bytes;
+	/* Index = band - 14; avoid the GIC white/yellow/green/blue/magenta palette. */
+	static const uint32_t colors[8] = {
+		0xFFFFFFFFu, 0xFFFF0000u, 0xFF00FF00u, 0xFFFFFF00u,
+		0xFF0000FFu, 0xFF00FFFFu, 0xFFFF8000u, 0xFF808080u
+	};
+	volatile uint32_t *p;
+
+	if (band < 14 || band >= 22 || kebab_fb_va == 0 || kebab_fb_band == 0) {
+		return;
+	}
+	bytes = kebab_fb_band;
+	p = (volatile uint32_t *)(kebab_fb_va + bytes * (uint64_t)(band - 14));
+	for (uint64_t i = 0; i < bytes / 4; i++) {
+		p[i] = colors[band - 14];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
 void * get_user_regs(thread_t);         /* XXX kludge for <machine/thread.h> */
 void IOKitInitializeTime(void);         /* XXX */
 void IOSleep(unsigned int);             /* XXX */
@@ -487,6 +516,11 @@ bsd_init(void)
 		.p_csflags = CS_VALID,
 	};
 	struct task_ro_data kerntask_ro_data = { };
+
+	/* Binary GIC/timer stub is installed; enable IRQs only now. */
+	ml_set_interrupts_enabled(TRUE);
+	kebab_bsd_mark(16);
+	panic("KEBAB PANIC TEST");
 #if CONFIG_NETBOOT || CONFIG_IMAGEBOOT
 	boolean_t       netboot = FALSE;
 #endif
@@ -504,17 +538,21 @@ bsd_init(void)
 #endif
 
 	throttle_init();
+	kebab_bsd_mark(14);
 
-	printf(copyright);
+	/* Bring-up: no serial or video console exists at bsd_init; skip the
+	 * blocking copyright printf. */
 
 #if CONFIG_DEV_KMEM
 	bsd_init_kprintf("calling dev_kmem_init\n");
 	dev_kmem_init();
 #endif
 
+	kebab_bsd_mark(15);
 	/* Initialize kauth subsystem before instancing the first credential */
 	bsd_init_kprintf("calling kauth_init\n");
 	kauth_init();
+	kebab_bsd_mark(17);
 
 	/* kernel_task->proc = kernproc; */
 	set_bsdtask_info(kernel_task, (void *)kernproc);
@@ -539,6 +577,7 @@ bsd_init(void)
 	kauth_cred_set(&kernproc_ro_data.p_ucred.__smr_ptr, vfs_context0.vc_ucred);
 	kernproc->p_proc_ro = proc_ro_alloc(kernproc, &kernproc_ro_data,
 	    kernel_task, &kerntask_ro_data);
+	kebab_bsd_mark(18);
 
 	/* give kernproc a name */
 	bsd_init_kprintf("calling process_name\n");
@@ -883,6 +922,7 @@ bsd_init(void)
 
 		bsd_init_kprintf("calling setconf\n");
 		setconf();
+		kebab_bsd_mark(19);
 #if CONFIG_NETBOOT
 		netboot = (mountroot == netboot_mountroot);
 #endif
