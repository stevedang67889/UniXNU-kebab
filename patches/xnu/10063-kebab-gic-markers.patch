+#include <pexpert/pexpert.h>
+
+/* Bring-up marker: paint one sixteenth of the GOP framebuffer from the GIC
+ * setup path, so a CPU fault can be located without the binary stubs. */
+static void
+kfb_mark(int band)
+{
+	unsigned long rb = PE_state.video.v_rowBytes;
+	unsigned long h = PE_state.video.v_height;
+
+	if (rb == 0) {
+		rb = 0x1000;
+	}
+	if (h == 0) {
+		h = 2400;
+	}
+	uint64_t len = (uint64_t)rb * h;
+	uint64_t fb = ml_io_map(0x9C000000, (vm_size_t)len);
+	uint64_t bytes = len >> 4;
+	static const uint32_t colors[8] = {
+		0xFFFFFFFFu, 0xFFFFFF00u, 0xFF00FF00u, 0xFF0000FFu,
+		0xFFFF00FFu, 0xFF00FFFFu, 0xFFFF0000u, 0xFF808080u
+	};
+	volatile uint32_t *p;
+
+	if (fb == 0 || bytes < 4 || band < 8 || band >= 16) {
+		return;
+	}
+	p = (volatile uint32_t *)(fb + bytes * (uint64_t)(band - 8));
+	for (uint64_t i = 0; i < bytes / 4; i++) {
+		p[i] = colors[band - 8];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
